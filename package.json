  "scripts": {
    "build": "sass --load-path=node_modules assets/styles/app.scss assets/generated/app.css --no-source-map --style=compressed && esbuild assets/app.js --bundle --minify --outfile=assets/generated/app.js && node scripts/copy-fonts.mjs",
