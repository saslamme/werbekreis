    "esbuild": "^0.25.0",
    "sass": "^1.89.0",
    "tom-select": "^2.2.2"
  },
  "dependencies": {
    "bootstrap": "^5.3.7",
    "@fortawesome/fontawesome-free": "^6.7.2"
  }
}
