{% extends '@SyliusAdminUi/base.html.twig' %}
{% block title %}Verwaltung · {{ portal_name }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('generated/app.css') }}">{% endblock %}
{% block javascripts %}<script src="{{ asset('generated/app.js') }}" defer></script>{% endblock %}
{% block body %}
<div class="admin-shell">
    <a class="skip-link" href="#main">Zum Inhalt</a>
    {% include 'admin/partials/_topbar.html.twig' %}
    {% include 'admin/partials/_sidebar.html.twig' %}
    <main id="main" class="admin-main" tabindex="-1">
        {% for type in ['success', 'error'] %}
            {% for message in app.flashes(type) %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : 'success' }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block admin_body %}{% endblock %}
    </main>
</div>
{% endblock %}
