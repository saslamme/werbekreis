{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ event.id ? 'Veranstaltung bearbeiten' : 'Veranstaltung anlegen' }}</h1>{{ form_start(form) }}{{ form_errors(form) }}
{% for heading, fields in {'Allgemein': ['title', 'slug', 'shortDescription', 'description', 'categories', 'company', 'active', 'featured'], 'Datum und Wiederholung': ['startsAt', 'endsAt', 'allDay', 'recurrenceType', 'recurrenceUntil'], 'Veranstalter': ['organizerName', 'organizerEmail', 'organizerPhone', 'organizerWebsite'], 'Veranstaltungsort': ['locationName', 'street', 'houseNumber', 'postalCode', 'city', 'latitude', 'longitude'], 'Darstellung': ['file', 'imageAlt', 'removeImage'], 'Weitere Informationen': ['freeAdmission', 'admissionText', 'externalUrl', 'ticketUrl'], 'Status': ['cancelled', 'cancellationNotice']} %}<section class="directory-form-section"><h2>{{ heading }}</h2>{% if heading == 'Darstellung' and event.imagePath and event.id %}<img class="directory-image mb-3" src="{{ path('admin_event_image', {id: event.id}) }}" alt="{{ event.imageAlt ?: event.title }}">{% endif %}<div class="row g-3">{% for field in fields %}<div class="col-md-6">{{ form_row(attribute(form, field)) }}</div>{% endfor %}</div></section>{% endfor %}
<button class="btn btn-primary" type="submit">Speichern</button> <a href="{{ path('admin_events') }}">Abbrechen</a>{{ form_end(form) }}
{% if event.id %}<form class="mt-4" action="{{ path('admin_event_delete', {id: event.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}"><button class="btn btn-outline-danger" type="submit">Veranstaltung löschen</button></form>{% endif %}{% endblock %}
