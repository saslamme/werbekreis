{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>Veranstaltungen</h1><a class="btn btn-primary" href="{{ path('admin_event_new') }}">Veranstaltung anlegen</a></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-3"><label for="event-title" class="form-label">Titel</label><input id="event-title" class="form-control" name="title" value="{{ filters.title }}"></div>
<div class="col-md-3"><label for="event-company" class="form-label">Unternehmen</label><select id="event-company" class="form-select" name="company"><option value="">Alle</option>{% for company in companies %}<option value="{{ company.id }}"{{ filters.company == company.id ? ' selected' }}>{{ company.name }}</option>{% endfor %}</select></div>
<div class="col-md-3"><label for="event-category" class="form-label">Kategorie</label><select id="event-category" class="form-select" name="category"><option value="">Alle</option>{% for category in categories %}<option value="{{ category.id }}"{{ filters.category == category.id ? ' selected' }}>{{ category.name }}</option>{% endfor %}</select></div>
{% for field, label in {active: 'Aktiv', featured: 'Hervorgehoben'} %}<div class="col-md-3"><label for="event-{{ field }}" class="form-label">{{ label }}</label><select id="event-{{ field }}" class="form-select" name="{{ field }}"><option value="">Alle</option><option value="1"{{ filters[field] == '1' ? ' selected' }}>Ja</option><option value="0"{{ filters[field] == '0' ? ' selected' }}>Nein</option></select></div>{% endfor %}
<div class="col-md-3"><label for="event-status" class="form-label">Status</label><select id="event-status" class="form-select" name="status"><option value="">Alle</option>{% for value, label in {planned: 'Geplant', running: 'Läuft', past: 'Vergangen', disabled: 'Deaktiviert', cancelled: 'Abgesagt'} %}<option value="{{ value }}"{{ filters.status == value ? ' selected' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="col-md-3"><label for="event-period" class="form-label">Zeitraum</label><select id="event-period" class="form-select" name="period"><option value="">Alle Zeiträume</option>{% for value, label in periods %}{% if value != 'upcoming' %}<option value="{{ value }}"{{ filters.period == value ? ' selected' }}>{{ label }}</option>{% endif %}{% endfor %}</select></div><div><button class="btn btn-outline-primary" type="submit">Filtern</button> <a href="{{ path('admin_events') }}">Zurücksetzen</a></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Titel</th><th>Unternehmen / Veranstalter</th><th>Kategorien</th><th>Beginn</th><th>Ende / Serie</th><th>Ort</th><th>Aktiv</th><th>Featured</th><th>Status</th><th>Aktionen</th></tr></thead><tbody>{% for event in rows %}{% set occurrence = event.representativeOccurrence(now) %}<tr><td><a href="{{ path('admin_event_show', {id: event.id}) }}">{{ event.title }}</a></td><td>{{ event.organizerLabel }}</td><td>{% for category in event.categories %}{{ category.name }}{{ not loop.last ? ', ' }}{% endfor %}</td><td>{{ event.startsAt|date('d.m.Y H:i', portal_timezone) }}</td><td>{{ event.endsAt|date('d.m.Y H:i', portal_timezone) }}{% if event.recurrenceUntil %}<br>{{ event.recurrenceType.label }} bis {{ event.recurrenceUntil|date('d.m.Y', portal_timezone) }}{% endif %}</td><td>{{ event.locationName }} {{ event.city }}</td><td>{{ event.active ? 'Ja' : 'Nein' }}</td><td>{{ event.featured ? 'Ja' : 'Nein' }}</td><td>{{ occurrence ? occurrence.statusAt(now) : 'Ohne Termine' }}</td><td><a href="{{ path('admin_event_edit', {id: event.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="10">Keine Veranstaltungen gefunden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_events'} %}{% endblock %}
