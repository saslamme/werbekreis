{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>Freigaben</h1><form method="get" class="row g-3 mb-4"><div class="col-md-3"><label for="review-type">Inhaltstyp</label><select id="review-type" name="type" class="form-select"><option value="">Alle Typen</option>{% for type in types %}<option value="{{ type.value }}" {{ filters.type == type.value ? 'selected' : '' }}>{{ type.label }}</option>{% endfor %}</select></div><div class="col-md-2"><label for="review-company">Unternehmen-ID</label><input class="form-control" id="review-company" name="company" value="{{ filters.company }}" inputmode="numeric"></div><div class="col-md-2"><label for="review-user">Einreicher-ID</label><input class="form-control" id="review-user" name="submitter" value="{{ filters.submitter }}" inputmode="numeric"></div>{% for field,label in {from:'Eingereicht ab',until:'Eingereicht bis'} %}<div class="col-md-2"><label for="review-{{ field }}">{{ label }}</label><input class="form-control" id="review-{{ field }}" type="date" name="{{ field }}" value="{{ attribute(filters,field) }}"></div>{% endfor %}<div class="col"><button class="btn btn-primary">Filtern</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Inhalt</th><th>Typ</th><th>Unternehmen</th><th>Eingereicht von</th><th>Zeitpunkt</th><th>Aktion</th></tr></thead><tbody>{% for revision in rows %}<tr><td>{{ revision.title }}</td><td>{{ revision.type.label }}</td><td>{{ revision.ownerCompany.name }}</td><td>{{ revision.submittedBy ? revision.submittedBy.email : 'Benutzer entfernt' }}</td><td>{{ revision.submittedAt|date('d.m.Y H:i',portal_timezone) }}</td><td><a href="{{ path('admin_review_show',{id:revision.id}) }}">Prüfen</a></td></tr>{% else %}<tr><td colspan="6">Keine offenen Freigaben.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route:'admin_reviews'} %}{% endblock %}
