{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>Freigabe prüfen: {{ revision.title }}</h1><p>{{ revision.type.label }} · {{ revision.ownerCompany.name }} · {{ revision.moderationStatus.label }}</p><p>Eingereicht von {{ revision.submittedBy ? revision.submittedBy.email : 'Benutzer entfernt' }} am {{ revision.submittedAt|date('d.m.Y H:i',portal_timezone) }}.</p>{% if revision.reviewNote %}<div class="alert alert-info">Letzter Prüfkommentar: {{ revision.reviewNote|nl2br }}</div>{% endif %}<div class="row g-4 member-review-columns"><section class="col-lg-6"><h2 class="h4">Vorgeschlagener Entwurf</h2>{{ form_start(proposal) }}{{ form_widget(proposal) }}{{ form_end(proposal) }}{% for name in revision.imageNames %}<img class="member-draft-image" src="{{ path('admin_review_image',{id:revision.id,fileName:name}) }}" alt="Entwurfsbild">{% endfor %}</section><section class="col-lg-6"><h2 class="h4">Aktueller gespeicherter Stand</h2><p>Ungeprüfte neue Inhalte sind noch nicht öffentlich. Bei bestehenden Inhalten bleibt dieser Stand bis zur Freigabe erhalten.</p>{{ form_start(current) }}{{ form_widget(current) }}{{ form_end(current) }}</section></div><section class="mt-4"><h2 class="h4">Entscheidung</h2>{% if pending %}{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary">Entscheidung speichern</button>{{ form_end(form) }}{% else %}<p>Dieser Entwurf wurde bereits geprüft. Für eine neue Entscheidung ist eine erneute Einreichung erforderlich.</p>{% endif %}</section>{% endblock %}
