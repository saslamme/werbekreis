<div class="table-responsive">
<table class="table">
<thead>
<tr>
<th>Name</th>
<th>E-Mail</th>
<th>Rolle</th>
<th>Status</th>
<th>Erstellt am</th>{% if editable %}<th>Aktion</th>{% endif %}</tr>
</thead>
<tbody>{% for user in users %}<tr>
<td>{{ user.firstName }} {{ user.lastName }}</td>
<td>{{ user.email }}</td>
<td>{% for role in user.roles %}{{ {'ROLE_ADMIN':'Admin','ROLE_EDITOR':'Editor','ROLE_MEMBER':'Mitglied'}[role]|default(role) }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
<td>{{ user.active ? 'Aktiv' : 'Inaktiv' }}</td>
<td>{{ user.createdAt|date('d.m.Y') }}</td>{% if editable %}<td>
<a href="{{ path('admin_user_edit', {id: user.id}) }}">Bearbeiten</a>
</td>{% endif %}</tr>{% else %}<tr>
<td colspan="{{ editable ? 6 : 5 }}">Noch keine Benutzer vorhanden.</td>
</tr>{% endfor %}</tbody>
</table>
</div>
