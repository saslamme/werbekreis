{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ product.id ? 'Gutscheinprodukt bearbeiten' : 'Gutscheinprodukt anlegen' }}</h1>{% if not is_granted('ROLE_ADMIN') %}<p>Sie können redaktionelle Inhalte bearbeiten. Wertmodell, Gültigkeit und Akzeptanzstellen verwaltet ein Admin.</p>{% endif %}{{ form_start(form) }}{{ form_widget(form) }}<button class="btn btn-primary">Speichern</button> <a href="{{ path('admin_voucher_products') }}">Abbrechen</a>{{ form_end(form) }}{% if product.id and is_granted('ROLE_ADMIN') %}<form class="mt-4" method="post" action="{{ path('admin_voucher_product_delete', {id: product.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_voucher_product_' ~ product.id) }}"><button class="btn btn-outline-danger">Produkt löschen</button></form>{% endif %}{% endblock %}
