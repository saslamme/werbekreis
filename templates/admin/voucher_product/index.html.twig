{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>Gutscheinprodukte</h1>{% if is_granted('ROLE_ADMIN') %}<a class="btn btn-primary" href="{{ path('admin_voucher_product_new') }}">Produkt anlegen</a>{% endif %}</div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Wertmodell</th><th>Gültigkeit</th><th>Aktiv</th><th>Akzeptanzstellen</th><th>Erstellt / geändert</th><th>Aktionen</th></tr></thead><tbody>{% for product in rows %}<tr><td>{{ product.name }}</td><td>{% if product.fixedAmount %}Fest: {{ voucher_money(product.fixedAmount) }}{% else %}Variabel: {{ voucher_money(product.minimumAmount) }}–{{ voucher_money(product.maximumAmount) }}{% endif %}</td><td>{{ product.validityMonths ? product.validityMonths ~ ' Monate' : 'Offen' }}</td><td>{{ product.active ? 'Ja' : 'Nein' }}</td><td>{{ product.acceptingCompanies|length }}</td><td>{{ product.createdAt|date('d.m.Y', portal_timezone) }} / {{ product.updatedAt|date('d.m.Y H:i', portal_timezone) }}</td><td><a href="{{ path('admin_voucher_product_edit', {id: product.id}) }}">{{ is_granted('ROLE_ADMIN') ? 'Bearbeiten' : 'Inhalte bearbeiten' }}</a></td></tr>{% else %}<tr><td colspan="7">Keine Produkte vorhanden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_voucher_products'} %}{% endblock %}
