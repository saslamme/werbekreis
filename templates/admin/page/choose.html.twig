{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ page.label }}: Inhaltselement hinzufügen</h1><a href="{{ path('admin_pages_edit', {code: page.code}) }}">Zurück zur Seite</a>
{% for group in ['Layout', 'Medien', 'Inhalte', 'Dynamische Inhalte'] %}<section class="admin-panel mt-4"><h2 class="h4">{{ group }}</h2><div class="row g-3">{% for type, info in types %}{% if info[1] == group %}<div class="col-sm-6 col-xl-4"><a class="card card-body h-100" href="{{ path('admin_elements_new', {code: page.code, type: type}) }}"><span><i class="fa-solid fa-{{ info[2] }} me-2" aria-hidden="true"></i>{{ info[0] }}</span></a></div>{% endif %}{% endfor %}</div></section>{% endfor %}{% endblock %}
