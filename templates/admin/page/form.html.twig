{% extends 'admin/base.html.twig' %}
{% block admin_body %}
<div class="admin-page-header"><div><h1>{{ page.label }} bearbeiten</h1><p>{{ page.publicUrl }}</p></div>
{% if page.code == 'board' %}<a class="btn btn-outline-primary" href="{{ path('admin_pages_board_members') }}">Vorstand verwalten</a>{% endif %}</div>
{{ form_start(form, {attr: {class: 'admin-edit-form'}}) }}
{{ form_errors(form) }}
<section class="admin-panel"><h2 class="h4">Allgemein</h2>{{ form_row(form.title) }}{{ form_row(form.lead) }}</section>
<section class="admin-panel"><h2 class="h4">Inhalt</h2>
<details class="mb-3"><summary>Zentrale Kontaktdaten im Text verwenden</summary><p>Diese Platzhalter werden mit den Portalwerten ersetzt: {organization}, {contact_name}, {contact_role}, {contact_phone}, {contact_email}, {street}, {postal_code}, {city}. HTML und Twig werden nicht ausgeführt.</p></details>
{% include 'admin/partials/_collection.html.twig' with {field: form.sections, add_label: 'Abschnitt hinzufügen', entry_class: 'admin-panel', auto_position: true} %}
</section>
<section class="admin-panel"><h2 class="h4">SEO</h2>{{ form_row(form.metaTitle) }}{{ form_row(form.metaDescription) }}</section>
<div class="admin-form-actions"><button class="btn btn-primary" type="submit">Speichern</button><a class="btn btn-outline-secondary" href="{{ path('admin_pages') }}">Abbrechen</a></div>
{{ form_end(form) }}
{% endblock %}
