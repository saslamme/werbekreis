{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="admin-page-header"><div><h1>{{ category.id ? 'Veranstaltungskategorie bearbeiten' : 'Veranstaltungskategorie anlegen' }}</h1></div></div>
{{ form_start(form, {attr: {class: 'admin-edit-form'}}) }}{{ form_widget(form) }}<div class="admin-form-actions"><button class="btn btn-primary" type="submit">Speichern</button> <a class="btn btn-outline-secondary" href="{{ path('admin_event_categories') }}">Abbrechen</a></div>{{ form_end(form) }}{% if category.id %}<form class="border-top mt-4 pt-4" method="post" action="{{ path('admin_event_category_delete', {id: category.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('delete_event_category_' ~ category.id) }}">
<p>Zugeordnete Kategorien können nicht gelöscht werden.</p>
<button class="btn btn-outline-danger" type="submit">Kategorie löschen</button>
</form>{% endif %}{% endblock %}
