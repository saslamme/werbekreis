{% extends 'admin/base.html.twig' %}
{% block admin_body %}
<div class="admin-page-header"><div><h1>Einstellungen</h1><p>Globale Einstellungen für das öffentliche Portal.</p></div></div>
{{ form_start(form, {attr: {class: 'admin-edit-form'}}) }}
{{ form_errors(form) }}
<section class="admin-panel"><h2 class="h4">Branding</h2>
<h3 class="h5">Website-Logo</h3>
{% if form.vars.data.logoFileName %}
<div class="mb-3">
<div class="admin-logo-preview-container">
<img style="--portal-logo-max-width: {{ form.vars.data.logoMaxWidth ?? 240 }}px; --portal-logo-max-height: {{ form.vars.data.logoMaxHeight ?? 60 }}px;" class="admin-logo-preview" src="{{ path('portal_logo', {v: form.vars.data.logoFileName}) }}" alt="{{ portal_name }}">
</div>
{% if form.vars.data.logoOriginalName %}<p class="mt-2 text-break">{{ form.vars.data.logoOriginalName }}</p>{% endif %}
</div>
{% endif %}
{{ form_row(form.logoFile, {label: 'Logo hochladen'}) }}
{% if form.removeLogo is defined %}{{ form_row(form.removeLogo) }}{% endif %}
<h3 class="h5 mt-4">Darstellung</h3>
<div class="row">
{% for field in [form.logoMaxWidth, form.logoMaxHeight] %}
<div class="col-md-6 mb-3">
{{ form_label(field) }}
<div class="input-group has-validation">
{{ form_widget(field, {attr: {'aria-describedby': field.vars.id ~ '_unit ' ~ field.vars.id ~ '_help'}}) }}
<span class="input-group-text" id="{{ field.vars.id }}_unit">px</span>
{{ form_errors(field) }}
</div>
{{ form_help(field) }}
</div>
{% endfor %}
</div>
<p class="small text-muted">Die Werte begrenzen die Darstellung des Logos. Das Seitenverhältnis bleibt erhalten.</p>
</section>
<section class="admin-panel"><h2 class="h4">Social Media</h2>
{{ form_row(form.facebookUrl) }}
{{ form_row(form.instagramUrl) }}
</section>
<div class="admin-form-actions"><button class="btn btn-primary" type="submit">Speichern</button></div>
{{ form_end(form) }}
{% endblock %}
