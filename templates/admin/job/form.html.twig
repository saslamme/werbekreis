{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ job.id ? 'Stelle bearbeiten' : 'Stelle anlegen' }}</h1>{{ form_start(form) }}{{ form_errors(form) }}
{% for heading, fields in {'Allgemein': ['company', 'title', 'slug', 'shortDescription', 'description', 'requirements', 'benefits', 'featured'], 'Beschäftigung': ['employmentType', 'workModel', 'startsAt', 'referenceNumber'], 'Arbeitsort': ['locationName', 'street', 'houseNumber', 'postalCode', 'city', 'addressCountry', 'latitude', 'longitude'], 'Veröffentlichung': ['status', 'publishedAt', 'validThrough'], 'Bewerbung': ['contactName', 'applicationEmail', 'contactPhone', 'applicationUrl'], 'Gehalt': ['salaryMin', 'salaryMax', 'salaryPeriod']} %}<section class="directory-form-section"><h2>{{ heading }}</h2><div class="row g-3">{% for field in fields %}<div class="{{ field in ['description', 'requirements', 'benefits'] ? 'col-12' : 'col-md-6' }}">{{ form_row(attribute(form, field)) }}</div>{% endfor %}</div></section>{% endfor %}
<button class="btn btn-primary" type="submit">Speichern</button> <a href="{{ path('admin_jobs') }}">Abbrechen</a>{{ form_end(form) }}{% if job.id %}<form class="mt-4" method="post" action="{{ path('admin_job_delete', {id: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete_job_' ~ job.id) }}"><button class="btn btn-outline-danger" type="submit">Stelle löschen</button></form>{% endif %}{% endblock %}
