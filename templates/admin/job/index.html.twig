{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>Jobs</h1><a class="btn btn-primary" href="{{ path('admin_job_new') }}">Stelle anlegen</a></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-4"><label for="job-title" class="form-label">Titel</label><input id="job-title" class="form-control" name="title" value="{{ filters.title }}"></div><div class="col-md-4"><label for="job-company" class="form-label">Unternehmen</label><select id="job-company" name="company" class="form-select"><option value="">Alle</option>{% for company in companies %}<option value="{{ company.id }}"{{ filters.company == company.id ? ' selected' }}>{{ company.name }}</option>{% endfor %}</select></div>
{% for key, config in {'employmentType': ['Beschäftigungsart', employment_types], 'workModel': ['Arbeitsmodell', work_models], 'status': ['Status', statuses]} %}<div class="col-md-4"><label class="form-label" for="job-{{ key }}">{{ config[0] }}</label><select class="form-select" name="{{ key }}" id="job-{{ key }}"><option value="">Alle</option>{% for item in config[1] %}<option value="{{ item.value }}"{{ attribute(filters, key) == item.value ? ' selected' }}>{{ item.label }}</option>{% endfor %}</select></div>{% endfor %}
<div class="col-md-4"><label class="form-label" for="job-featured">Hervorgehoben</label><select class="form-select" id="job-featured" name="featured"><option value="">Alle</option><option value="1"{{ filters.featured == '1' ? ' selected' }}>Ja</option><option value="0"{{ filters.featured == '0' ? ' selected' }}>Nein</option></select></div><div><button class="btn btn-outline-primary" type="submit">Filtern</button> <a href="{{ path('admin_jobs') }}">Zurücksetzen</a></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Titel</th><th>Unternehmen</th><th>Beschäftigung</th><th>Ort</th><th>Status</th><th>Veröffentlicht</th><th>Gültig bis</th><th>Featured</th><th>Geändert</th><th>Aktionen</th></tr></thead><tbody>{% for job in rows %}<tr><td><a href="{{ path('admin_job_show', {id: job.id}) }}">{{ job.title }}</a></td><td>{{ job.company.name }}</td><td>{{ job.employmentType.label }}<br>{{ job.workModel.label }}</td><td>{{ job.city ?: 'Remote' }}</td><td>{{ job.statusAt(now) }}</td><td>{{ job.publishedAt ? job.publishedAt|date('d.m.Y H:i', portal_timezone) : 'Ohne Zeitpunkt' }}</td><td>{{ job.validThrough ? job.validThrough|date('d.m.Y', portal_timezone) : 'Offen' }}</td><td>{{ job.featured ? 'Ja' : 'Nein' }}</td><td>{{ job.updatedAt|date('d.m.Y H:i', portal_timezone) }}</td><td><a href="{{ path('admin_job_edit', {id: job.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="10">Keine Stellen gefunden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_jobs'} %}{% endblock %}
