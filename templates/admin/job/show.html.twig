{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ job.title }}</h1><p>{{ job.company.name }} · {{ job.statusAt(now) }}</p><p>{{ job.employmentType.label }} · {{ job.workModel.label }} · {{ job.city }}</p><p>{{ job.shortDescription }}</p><h2>Beschreibung</h2><div>{{ job.description|nl2br }}</div>{% if job.requirements %}<h2>Anforderungen</h2><div>{{ job.requirements|nl2br }}</div>{% endif %}{% if job.benefits %}<h2>Benefits</h2><div>{{ job.benefits|nl2br }}</div>{% endif %}{% include 'frontend/job/_salary.html.twig' %}<dl><dt>Veröffentlichung</dt><dd>{{ job.publishedAt ? job.publishedAt|date('d.m.Y H:i', portal_timezone) : 'Ohne Zeitpunkt' }}</dd><dt>Bewerbungsfrist</dt><dd>{{ job.validThrough ? job.validThrough|date('d.m.Y', portal_timezone) : 'Offen' }}</dd><dt>Bewerbung</dt><dd>{{ job.applicationUrl }} {{ job.effectiveApplicationEmail }}</dd><dt>Kontakt</dt><dd>{{ job.contactName }} {{ job.contactPhone }}</dd><dt>Arbeitsort</dt><dd>{{ job.locationName }} {{ job.street }} {{ job.houseNumber }} {{ job.postalCode }} {{ job.city }}</dd></dl><a class="btn btn-primary" href="{{ path('admin_job_edit', {id: job.id}) }}">Bearbeiten</a> <a href="{{ path('admin_jobs') }}">Alle Stellen</a>{% endblock %}
