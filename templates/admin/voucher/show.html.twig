{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>Gutschein {{ voucher.code }}</h1><dl class="row"><dt class="col-sm-4">Produkt</dt><dd class="col-sm-8">{{ voucher.product.name }}</dd><dt class="col-sm-4">Status</dt><dd class="col-sm-8">{{ voucher.effectiveStatus(now).label }}</dd><dt class="col-sm-4">Ursprünglicher Wert</dt><dd class="col-sm-8">{{ voucher_money(voucher.initialAmount) }}</dd><dt class="col-sm-4">Restguthaben</dt><dd class="col-sm-8 voucher-balance">{{ voucher_money(voucher.remainingAmount) }}</dd>{% for field, label in {'issuedAt': 'Ausgegeben am', 'validFrom': 'Gültig ab', 'activatedAt': 'Aktiviert am', 'validUntil': 'Gültig bis', 'blockedAt': 'Gesperrt am', 'redeemedAt': 'Vollständig eingelöst am'} %}<dt class="col-sm-4">{{ label }}</dt><dd class="col-sm-8">{{ attribute(voucher, field) ? attribute(voucher, field)|date('d.m.Y H:i', portal_timezone) : '–' }}</dd>{% endfor %}<dt class="col-sm-4">Interne Notiz</dt><dd class="col-sm-8">{{ voucher.note }}</dd></dl><div class="d-flex flex-wrap gap-3 mb-4">{% for action, label in {'activate': 'Aktivieren', 'block': 'Sperren', 'unblock': 'Entsperren', 'delete': 'Nicht aktivierten Gutschein löschen'} %}<form method="post" action="{{ path('admin_voucher_action', {id: voucher.id, action: action}) }}"><input type="hidden" name="_token" value="{{ csrf_token('voucher_' ~ action ~ '_' ~ voucher.id) }}"><button class="btn btn-outline-primary">{{ label }}</button></form>{% endfor %}<a href="{{ path('admin_voucher_edit', {id: voucher.id}) }}">Notiz bearbeiten</a><a href="{{ path('voucher_redeem') }}">Zur Einlösung</a></div><h2>Einlösungshistorie</h2><div class="table-responsive"><table class="table"><thead><tr><th>Datum</th><th>Akzeptanzstelle</th><th>Betrag</th><th>Guthaben vorher</th><th>Guthaben danach</th><th>Benutzer</th><th>Referenz</th><th>Notiz</th></tr></thead><tbody>{% for entry in history %}<tr><td>{{ entry.redeemedAt|date('d.m.Y H:i:s', portal_timezone) }}</td><td>{{ entry.companyName }}</td><td>{{ voucher_money(entry.amount) }}</td><td>{{ voucher_money(entry.balanceBefore) }}</td><td>{{ voucher_money(entry.balanceAfter) }}</td><td>{{ entry.actorIdentifier }}</td><td>{{ entry.reference }}</td><td>{{ entry.note }}</td></tr>{% else %}<tr><td colspan="8">Noch keine Einlösungen.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_voucher_show'} %}{% endblock %}
