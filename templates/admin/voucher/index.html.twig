{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>Gutscheine</h1><a class="btn btn-primary" href="{{ path('admin_voucher_new') }}">Gutschein erstellen</a></div>{{ form_start(code_form) }}{{ form_widget(code_form) }}<button class="btn btn-outline-primary">Code suchen</button>{{ form_end(code_form) }}<form method="get" class="row g-3 my-3"><div class="col-md-4"><label for="voucher-product" class="form-label">Produkt</label><select class="form-select" id="voucher-product" name="product"><option value="">Alle</option>{% for product in products %}<option value="{{ product.id }}"{{ filters.product == product.id ? ' selected' }}>{{ product.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label for="voucher-status" class="form-label">Status</label><select class="form-select" id="voucher-status" name="status"><option value="">Alle</option>{% for status in statuses %}<option value="{{ status.value }}"{{ filters.status == status.value ? ' selected' }}>{{ status.label }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label" for="voucher-validity">Gültigkeit</label><select id="voucher-validity" class="form-select" name="validity"><option value="">Alle</option><option value="usable"{{ filters.validity == 'usable' ? ' selected' }}>Einlösbar</option><option value="expired"{{ filters.validity == 'expired' ? ' selected' }}>Abgelaufen</option></select></div><div><button class="btn btn-outline-primary">Filtern</button> <a href="{{ path('admin_vouchers') }}">Zurücksetzen</a></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Produkt</th><th>Ursprünglicher Wert</th><th>Restguthaben</th><th>Status</th><th>Aktiviert</th><th>Gültig bis</th><th>Geändert</th></tr></thead><tbody>{% for voucher in rows %}<tr><td><a href="{{ path('admin_voucher_show', {id: voucher.id}) }}">{{ voucher.code }}</a></td><td>{{ voucher.product.name }}</td><td>{{ voucher_money(voucher.initialAmount) }}</td><td>{{ voucher_money(voucher.remainingAmount) }}</td><td>{{ voucher.effectiveStatus(now).label }}</td><td>{{ voucher.activatedAt ? voucher.activatedAt|date('d.m.Y H:i', portal_timezone) : 'Noch nicht' }}</td><td>{{ voucher.validUntil ? voucher.validUntil|date('d.m.Y H:i', portal_timezone) : 'Offen' }}</td><td>{{ voucher.updatedAt|date('d.m.Y H:i', portal_timezone) }}</td></tr>{% else %}<tr><td colspan="8">Keine Gutscheine gefunden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_vouchers'} %}{% endblock %}
