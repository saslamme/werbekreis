{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>{{ article.title }}</h1><a class="btn btn-primary" href="{{ path('admin_news_edit', {id: article.id}) }}">Bearbeiten</a></div><p>{{ article.statusAt(now) }}</p>{% include 'frontend/news/_meta.html.twig' %}{% if article.imagePath %}<img class="directory-image" src="{{ path('admin_news_image', {id: article.id}) }}" alt="{{ article.imageAltText ?: article.title }}">{% endif %}<p>{{ article.teaser }}</p><div class="company-description">{{ article.content|nl2br }}</div><a href="{{ path('admin_news') }}">Alle Beiträge</a>{% endblock %}
