{% extends 'admin/base.html.twig' %}
{% block admin_body %}<div class="section-heading"><h1>News</h1><a class="btn btn-primary" href="{{ path('admin_news_new') }}">Beitrag anlegen</a></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-3"><label class="form-label" for="news-title">Titel</label><input id="news-title" name="title" class="form-control" value="{{ filters.title }}"></div><div class="col-md-3"><label class="form-label" for="news-company">Unternehmen</label><select id="news-company" name="company" class="form-select"><option value="">Alle</option>{% for company in companies %}<option value="{{ company.id }}"{{ filters.company == company.id ? ' selected' }}>{{ company.name }}</option>{% endfor %}</select></div>
<div class="col-md-3"><label class="form-label" for="news-category">Kategorie</label><select id="news-category" name="category" class="form-select"><option value="">Alle</option>{% for category in categories %}<option value="{{ category.id }}"{{ filters.category == category.id ? ' selected' }}>{{ category.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label" for="news-status">Status</label><select id="news-status" name="status" class="form-select"><option value="">Alle</option>{% for status in statuses %}<option value="{{ status.value }}"{{ filters.status == status.value ? ' selected' }}>{{ status.label }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label" for="news-featured">Hervorgehoben</label><select id="news-featured" name="featured" class="form-select"><option value="">Alle</option><option value="1"{{ filters.featured == '1' ? ' selected' }}>Ja</option><option value="0"{{ filters.featured == '0' ? ' selected' }}>Nein</option></select></div><div><button class="btn btn-outline-primary" type="submit">Filtern</button> <a href="{{ path('admin_news') }}">Zurücksetzen</a></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Titel</th><th>Unternehmen</th><th>Kategorien</th><th>Status</th><th>Veröffentlicht am</th><th>Featured</th><th>Geändert</th><th>Aktionen</th></tr></thead><tbody>{% for article in rows %}<tr><td><a href="{{ path('admin_news_show', {id: article.id}) }}">{{ article.title }}</a></td><td>{{ article.company ? article.company.name : 'Allgemein' }}</td><td>{% for category in article.categories %}{{ category.name }}{{ not loop.last ? ', ' }}{% endfor %}</td><td>{{ article.statusAt(now) }}{% if article.status.value == 'scheduled' %}<br><small>Automatische Veröffentlichung</small>{% endif %}</td><td>{{ article.publishedAt ? article.publishedAt|date('d.m.Y H:i', portal_timezone) : 'Ohne Zeitpunkt' }}</td><td>{{ article.featured ? 'Ja' : 'Nein' }}</td><td>{{ article.updatedAt|date('d.m.Y H:i', portal_timezone) }}</td><td><a href="{{ path('admin_news_edit', {id: article.id}) }}">Bearbeiten</a></td></tr>{% else %}<tr><td colspan="8">Keine Beiträge gefunden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route: 'admin_news'} %}{% endblock %}
