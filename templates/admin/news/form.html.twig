{% extends 'admin/base.html.twig' %}
{% block admin_body %}<h1>{{ article.id ? 'Beitrag bearbeiten' : 'Beitrag anlegen' }}</h1>{{ form_start(form) }}{{ form_errors(form) }}
{% for heading, fields in {'Inhalt': ['title', 'slug', 'teaser', 'content', 'categories', 'company', 'featured'], 'Veröffentlichung': ['status', 'publishedAt'], 'Darstellung': ['file', 'imageAltText', 'removeImage'], 'Weitere Informationen': ['authorName', 'externalUrl']} %}<section class="directory-form-section"><h2>{{ heading }}</h2>{% if heading == 'Darstellung' and article.imagePath and article.id %}<img class="directory-image mb-3" src="{{ path('admin_news_image', {id: article.id}) }}" alt="{{ article.imageAltText ?: article.title }}">{% endif %}<div class="row g-3">{% for field in fields %}<div class="{{ field == 'content' ? 'col-12' : 'col-md-6' }}">{{ form_row(attribute(form, field)) }}</div>{% endfor %}</div></section>{% endfor %}
<button class="btn btn-primary" type="submit">Speichern</button> <a href="{{ path('admin_news') }}">Abbrechen</a>{{ form_end(form) }}{% if article.id %}<form class="mt-4" action="{{ path('admin_news_delete', {id: article.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('delete_news_' ~ article.id) }}"><button class="btn btn-outline-danger" type="submit">Beitrag löschen</button></form>{% endif %}{% endblock %}
