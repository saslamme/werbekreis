{% extends 'member/base.html.twig' %}
{% block member_body %}<div class="section-heading"><h2>{{ kind.label }}: {{ target.id ? 'Entwurf bearbeiten' : 'Entwurf anlegen' }}</h2><a href="{{ path('member_content',{type:kind.value}) }}">Zur Liste</a></div><p>Unternehmen: <strong>{{ kind.value == 'companies' ? target.name : target.company.name }}</strong>. Speichern verändert ausschließlich den Entwurf.</p>{% if revision %}<p>Status: <strong>{{ revision.moderationStatus.label }}</strong></p>{% if revision.reviewNote %}<div class="alert alert-info"><h3 class="h5">Letzter Prüfkommentar</h3><p class="mb-0">{{ revision.reviewNote|nl2br }}</p></div>{% endif %}{% endif %}{% if not editable %}<p class="alert alert-info">Dieser Entwurf wird geprüft. Währenddessen ist er nicht bearbeitbar.</p>{% endif %}{{ form_start(form) }}{{ form_errors(form) }}{% for field in form %}{% if field.vars.name in ['openingHours','contactPersons','images'] %}<section class="directory-form-section"><h3 class="h5">{{ field.vars.name == 'openingHours' ? 'Öffnungszeiten' : (field.vars.name == 'images' ? 'Bilder' : 'Ansprechpartner') }}</h3>{% if editable %}{% include 'admin/partials/_collection.html.twig' with {field:field,add_label:'Eintrag hinzufügen'} %}{% else %}{{ form_widget(field) }}{% endif %}</section>{% else %}{{ form_row(field) }}{% endif %}{% endfor %}{% if editable %}<button class="btn btn-primary">Entwurf speichern</button>{% endif %}{{ form_end(form) }}{% if revision and revision.moderationStatus.editable %}<div class="d-flex flex-wrap gap-3 mt-4"><form method="post" action="{{ path('member_revision_action',{id:revision.id,action:'submit'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('revision_submit_' ~ revision.id) }}"><input type="hidden" name="version" value="{{ revision.version }}"><button class="btn btn-primary">Zur Freigabe einreichen</button></form><form method="post" action="{{ path('member_revision_action',{id:revision.id,action:'discard'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('revision_discard_' ~ revision.id) }}"><input type="hidden" name="version" value="{{ revision.version }}"><button class="btn btn-outline-danger">Entwurf verwerfen</button></form></div>{% endif %}{% if revision and revision.imageNames is not empty %}<h3 class="h5 mt-4">Entwurfsbilder</h3><div class="d-flex flex-wrap gap-3">{% for name in revision.imageNames %}<img class="member-draft-image" src="{{ path('member_revision_image',{id:revision.id,fileName:name}) }}" alt="Bild im Entwurf">{% endfor %}</div>{% endif %}{% endblock %}
