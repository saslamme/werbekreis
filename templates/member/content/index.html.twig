{% extends 'member/base.html.twig' %}
{% block member_body %}<div class="section-heading"><h2>{{ kind.label }}</h2>{% if kind.value != 'companies' and app.user.companies is not empty %}<a class="btn btn-primary" href="{{ path('member_content_new',{type:kind.value}) }}">Entwurf anlegen</a>{% endif %}</div><div class="table-responsive"><table class="table"><thead><tr><th>Titel</th><th>Unternehmen</th><th>Status</th><th>Letzte Änderung</th><th>Aktion</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.title }}</td><td>{{ row.companyName }}</td><td><span class="member-status">{{ row.statusLabel }}</span></td><td>{{ (row.draftUpdatedAt ?? row.updatedAt)|date('d.m.Y H:i',portal_timezone) }}</td><td><a href="{{ path('member_content_edit',{type:kind.value,id:row.id}) }}">Ansehen / bearbeiten</a>{% if row.reviewNote %}<p class="mt-2">Prüfkommentar: {{ row.reviewNote }}</p>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Keine eigenen Inhalte vorhanden.</td></tr>{% endfor %}</tbody></table></div>{% include 'partials/_pagination.html.twig' with {route:'member_content'} %}<p>Entwurf: bearbeitbar. In Prüfung: wartet auf Freigabe. Änderungen erforderlich oder abgelehnt: Kommentar beachten, überarbeiten und erneut einreichen. Freigegeben: Veröffentlichung folgt den jeweiligen Zeit- und Aktivierungsregeln.</p>{% endblock %}
