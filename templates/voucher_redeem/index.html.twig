{% extends 'base.html.twig' %}
{% block title %}Gutschein einlösen | {{ portal_name }}{% endblock %}
{% block canonical %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block body %}<section class="section"><div class="container voucher-content"><h1>Gutschein einlösen</h1>{% if error %}<p class="alert alert-warning" role="alert">{{ error }}</p>{% endif %}{% if voucher %}<section class="voucher-result"><h2>{{ voucher.product.name }}</h2><p>{{ voucher.maskedCode }} · {{ voucher.publicStatusLabel(now) }}</p><p>Ursprünglicher Wert: {{ voucher_money(voucher.initialAmount) }}</p><p>Restguthaben <strong class="voucher-balance">{{ voucher_money(voucher.remainingAmount) }}</strong></p>{% if voucher.validUntil %}<p>Gültig bis {{ voucher.validUntil|date('d.m.Y H:i', portal_timezone) }}</p>{% endif %}</section>{% endif %}
{% if confirmation and preview %}<section class="mt-4"><h2>Einlösung bestätigen</h2><p class="lead">{{ voucher_money(preview.amount) }} bei {{ preview.companyName }} einlösen?</p>{{ form_start(confirmation) }}{{ form_widget(confirmation) }}<button class="btn btn-primary btn-lg">Verbindlich einlösen</button>{{ form_end(confirmation) }}<a class="d-block mt-3" href="{{ path('voucher_redeem') }}">Abbrechen und neu prüfen</a></section>{% elseif entry_form %}<div class="mt-4">{{ form_start(entry_form) }}{{ form_widget(entry_form) }}<button class="btn btn-primary btn-lg">Einlösung prüfen</button>{{ form_end(entry_form) }}</div>{% else %}<p>Gutscheincode eingeben. Die Einlösung wird erst nach Ihrer ausdrücklichen Bestätigung ausgeführt.</p>{{ form_start(lookup) }}{{ form_widget(lookup) }}<button class="btn btn-primary btn-lg">Gutschein suchen</button>{{ form_end(lookup) }}{% endif %}{% if is_granted('ROLE_ADMIN') %}<p class="mt-4"><a href="{{ path('admin_vouchers') }}">Zur Gutscheinverwaltung</a></p>{% endif %}</div></section>{% endblock %}
