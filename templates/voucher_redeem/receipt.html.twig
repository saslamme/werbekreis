{% extends 'base.html.twig' %}
{% block canonical %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block body %}<section class="section"><div class="container voucher-content"><h1>Einlösung erfolgreich</h1><div class="voucher-result" role="status"><dl><dt>Eingelöster Betrag</dt><dd>{{ voucher_money(entry.amount) }}</dd><dt>Neues Restguthaben</dt><dd class="voucher-balance">{{ voucher_money(entry.balanceAfter) }}</dd><dt>Status nach Einlösung</dt><dd>{{ entry.resultStatus.label }}</dd><dt>Akzeptanzstelle</dt><dd>{{ entry.companyName }}</dd><dt>Zeitpunkt</dt><dd>{{ entry.redeemedAt|date('d.m.Y H:i:s', portal_timezone) }}</dd></dl></div><a class="btn btn-primary mt-4" href="{{ path('voucher_redeem') }}">Weiteren Gutschein einlösen</a></div></section>{% endblock %}
