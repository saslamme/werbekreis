{% extends 'admin/base.html.twig' %}
{% block metatags %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block admin_body %}<div class="admin-page-header"><div><h1>Einlösung erfolgreich</h1></div></div><div class="voucher-result" role="status"><dl><dt>Eingelöster Betrag</dt><dd>{{ voucher_money(entry.amount) }}</dd><dt>Neues Restguthaben</dt><dd class="voucher-balance">{{ voucher_money(entry.balanceAfter) }}</dd><dt>Status nach Einlösung</dt><dd>{{ entry.resultStatus.label }}</dd><dt>Akzeptanzstelle</dt><dd>{{ entry.companyName }}</dd><dt>Zeitpunkt</dt><dd>{{ entry.redeemedAt|date('d.m.Y H:i:s', portal_timezone) }}</dd></dl></div><a class="btn btn-primary mt-4" href="{{ path('voucher_redeem') }}">Weiteren Gutschein einlösen</a>{% endblock %}

{% block cookie_notice %}{% endblock %}
