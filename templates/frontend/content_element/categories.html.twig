<section class="section"><div class="container"><div class="section-heading"><h2>{{ data.heading }}</h2><span class="text-secondary">{{ data.subheading }}</span></div>{% if categories is empty %}<p class="text-secondary">Kategorien werden in Kürze ergänzt.</p>{% else %}<div class="row g-3">{% for row in categories %}<div class="col-6 col-md-4 col-lg-2">{% include 'frontend/category/_card.html.twig' with {category: row.category, count: row.companyCount} %}</div>{% endfor %}</div>{% endif %}</div></section>
