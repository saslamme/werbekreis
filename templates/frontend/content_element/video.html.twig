{% if embedUrl %}<section class="section"><div class="container">{% if data.heading %}<h2>{{ data.heading }}</h2>{% endif %}<div class="content-video" data-content-video="{{ embedUrl }}" data-video-title="{{ data.heading ?: 'Video' }}">{% for media in element.media %}{% include 'frontend/content_element/_media.html.twig' %}{% endfor %}<p>Externe Videos werden erst nach Ihrer Zustimmung geladen. Dabei wird Ihre IP-Adresse an den Videoanbieter übermittelt.</p><button type="button" class="btn btn-primary" data-load-video>Video laden</button></div>{% if data.caption %}<p>{{ data.caption }}</p>{% endif %}</div></section>{% endif %}
