{% if element.media is not empty %}<section class="section"><div class="container"><div id="content-slider-{{ element.id }}" class="carousel slide"{% if data.autoplay %} data-bs-ride="carousel" data-bs-interval="{{ max(3000, data.interval) }}"{% endif %}><div class="carousel-inner">{% for media in element.media %}<div class="carousel-item{{ loop.first ? ' active' }}">{% include 'frontend/content_element/_media.html.twig' %}</div>{% endfor %}</div>{% if element.media|length > 1 %}<button class="carousel-control-prev" type="button" data-bs-target="#content-slider-{{ element.id }}" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Vorheriges Bild</span></button><button class="carousel-control-next" type="button" data-bs-target="#content-slider-{{ element.id }}" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Nächstes Bild</span></button>{% endif %}</div></div></section>{% endif %}
