<section class="section pt-0"><div class="container"><div class="{{ data.variant == 'green' ? 'join-box' : (data.variant == 'dark' ? 'bg-dark text-white p-4 rounded' : 'page-cta') }}"><div class="row align-items-center gy-4"><div class="col-lg-8">{% if data.eyebrow %}<p class="small">{% include 'frontend/page/_text.html.twig' with {text: data.eyebrow} %}</p>{% endif %}{% if data.heading %}<h2>{{ data.heading }}</h2>{% endif %}<p class="mb-0">{% include 'frontend/page/_text.html.twig' with {text: data.text} %}</p>{% for media in element.media %}{% include 'frontend/content_element/_media.html.twig' %}{% endfor %}</div><div class="col-lg-4 text-lg-end">{% if data.buttonLabel and data.buttonUrl %}<a class="btn {{ data.variant == 'light' ? 'btn-primary' : 'btn-light' }}" href="{{ data.buttonUrl }}">{{ data.buttonLabel }} <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>{% endif %}</div></div></div></div></section>
