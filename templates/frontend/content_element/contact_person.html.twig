<section class="section"><div class="container"><article class="page-card">{% for media in element.media %}{% include 'frontend/content_element/_media.html.twig' %}{% endfor %}<h2>{{ data.name }}</h2><p>{{ data.role }}{% if data.company %} · {{ data.company }}{% endif %}</p><p>{{ data.text|nl2br }}</p>{% if data.phone %}<p><a href="tel:{{ data.phone|replace({' ': '', '(': '', ')': '', '/': '', '.': '', '-': ''}) }}">{{ data.phone }}</a></p>{% endif %}{% if data.email %}<p><a href="mailto:{{ data.email }}">{{ data.email }}</a></p>{% endif %}</article></div></section>
