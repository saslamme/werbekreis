<section class="section"><div class="container"><div class="section-heading"><h2>{{ data.heading }}</h2>{% if data.subheading %}<span class="text-secondary">{{ data.subheading }}</span>{% endif %}{% if data.showAllLink %}<a href="{{ path('company_index') }}">Alle Unternehmen</a>{% endif %}</div>{% if items is empty %}<p role="status">Es sind noch keine Unternehmen eingetragen.</p>{% else %}<div class="row g-4">{% for company in items %}<div class="col-md-6 col-lg-4">{% include 'frontend/company/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
