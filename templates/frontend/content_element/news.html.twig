<section class="section"><div class="container"><div class="section-heading"><h2>{{ data.heading }}</h2>{% if data.showAllLink %}<a href="{{ path('news_index') }}">Alle Neuigkeiten</a>{% endif %}</div>{% if items is empty %}<p role="status">Aktuell sind keine Neuigkeiten verfügbar.</p>{% else %}<div class="row g-4">{% for article in items %}<div class="col-md-6 col-lg-4">{% include 'frontend/news/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
