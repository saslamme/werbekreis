<section class="section"><div class="container page-content"><address><strong>{{ portal_organization }}</strong>{% if data.showPerson %}<br>{{ portal_contact_name }}{% if portal_contact_role %} · {{ portal_contact_role }}{% endif %}{% endif %}{% if data.showAddress %}<br>{{ portal_street }}<br>{{ portal_postal_code }} {{ portal_city }}{% endif %}</address>{% if data.showPhone and portal_contact_phone %}<p><a href="tel:{{ portal_contact_phone|replace({' ': '', '(': '', ')': '', '/': '', '-': ''}) }}">{{ portal_contact_phone }}</a></p>{% endif %}{% if data.showEmail and portal_contact_email %}<p><a href="mailto:{{ portal_contact_email }}">{{ portal_contact_email }}</a></p>{% endif %}</div></section>
