<section class="section bg-light"><div class="container"><div class="section-heading"><h2>{{ data.heading }}</h2>{% if data.showAllLink %}<a href="{{ path('event_index') }}">Alle Veranstaltungen</a>{% endif %}</div>{% if items is empty %}<p role="status">Aktuell sind keine Veranstaltungen verfügbar.</p>{% else %}<div class="row g-4">{% for occurrence in items %}<div class="col-md-6 col-lg-4">{% include 'frontend/event/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
