<section class="section bg-light"><div class="container"><div class="section-heading"><h2>{{ data.heading }}</h2>{% if data.showAllLink %}<a href="{{ path('offer_index') }}">Alle Angebote</a>{% endif %}</div>{% if items is empty %}<p role="status">Aktuell sind keine Angebote verfügbar.</p>{% else %}<div class="row g-4">{% for offer in items %}<div class="col-md-6 col-lg-4">{% include 'frontend/offer/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
