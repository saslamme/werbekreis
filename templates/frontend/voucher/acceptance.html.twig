{% extends 'base.html.twig' %}
{% block body_class %}public-frontend{% endblock %}
{% block title %}Gutschein-Akzeptanzstellen in {{ portal_city }} | {{ portal_name }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('voucher_acceptance') }}">{% if parameters is not empty or page > 1 %}<meta name="robots" content="noindex,follow">{% endif %}{% endblock %}
{% block body %}<header class="directory-hero"><div class="container">{% include 'partials/_breadcrumb.html.twig' with {items: [{label: 'Gutschein', url: path('voucher_index')}, {label: 'Akzeptanzstellen'}]} only %}<h1>Gutschein-Akzeptanzstellen</h1><p class="lead">Hier können Sie Ihren Gutschein vor Ort einlösen.</p><form method="get" class="public-filters row g-3"><div class="col-md-4"><label class="form-label" for="acceptance-search">Suchbegriff</label><input class="form-control" id="acceptance-search" name="q" value="{{ search }}"></div><div class="col-md-4"><label class="form-label" for="acceptance-product">Gutscheinprodukt</label><select class="form-select" id="acceptance-product" name="produkt"><option value="">Alle Produkte</option>{% for item in products %}<option value="{{ item.slug }}"{{ product and product.id == item.id ? ' selected' }}>{{ item.name }}</option>{% endfor %}</select></div><div class="col-md-4"><label class="form-label" for="acceptance-category">Kategorie</label><select class="form-select" id="acceptance-category" name="kategorie"><option value="">Alle Kategorien</option>{% for item in categories %}<option value="{{ item.slug }}"{{ category and category.id == item.id ? ' selected' }}>{{ item.name }}</option>{% endfor %}</select></div><div><button class="btn btn-primary">Filtern</button>{% if search or product or category %} <a class="filter-reset" href="{{ path('voucher_acceptance') }}">Filter zurücksetzen</a>{% endif %}</div></form></div></header><section class="section"><div class="container"><h2 class="results-heading">{{ companies|length }} {{ companies|length == 1 ? 'Akzeptanzstelle' : 'Akzeptanzstellen' }}</h2>{% if companies|length == 0 %}<p class="directory-empty" role="status">Für diese Auswahl sind keine Akzeptanzstellen verfügbar.</p>{% else %}<div class="row g-4">{% for company in companies %}<div class="col-md-6 col-lg-4">{% include 'frontend/company/_card.html.twig' %}<p class="mt-2">{{ company.street }} {{ company.houseNumber }} · {{ company.postalCode }} {{ company.city }}</p></div>{% endfor %}</div>{% endif %}{% include 'partials/_pagination.html.twig' with {route: 'voucher_acceptance'} %}<p class="mt-4"><a href="{{ path('voucher_index') }}">Zum Gutschein</a></p></div></section>{% endblock %}
