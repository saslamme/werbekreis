{% extends 'base.html.twig' %}
{% block title %}Gutschein prüfen | {{ portal_name }}{% endblock %}
{% block canonical %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block body %}<section class="section"><div class="container voucher-content"><h1>Gutschein prüfen</h1><p>Prüfen Sie Gültigkeit und Restguthaben. Ihr Code wird nicht in der Adresse der Seite angezeigt.</p>{{ form_start(form, {attr: {class: 'voucher-check-form'}}) }}{{ form_widget(form) }}<button class="btn btn-primary btn-lg">Gutschein prüfen</button>{{ form_end(form) }}{% if message %}<p class="alert alert-warning mt-4" role="status">{{ message }}</p>{% endif %}{% if result %}<section class="voucher-result mt-4" aria-labelledby="check-result"><h2 id="check-result">{{ result.usable ? 'Gutschein gültig' : 'Gutschein derzeit nicht gültig' }}</h2><dl><dt>Produkt</dt><dd>{{ result.product }}</dd><dt>Status</dt><dd>{{ result.status }}</dd><dt>Restguthaben</dt><dd class="voucher-balance">{{ voucher_money(result.remaining) }}</dd>{% if result.until %}<dt>Gültig bis</dt><dd>{{ result.until|date('d.m.Y H:i', portal_timezone) }}</dd>{% endif %}</dl></section>{% endif %}<p class="mt-4"><a href="{{ path('voucher_index') }}">Zur Gutscheinübersicht</a></p></div></section>{% endblock %}
