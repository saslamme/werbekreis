{% extends 'base.html.twig' %}
{% block body %}
<section class="hero">
<div class="container">
<div class="row align-items-center gy-5">
<div class="col-lg-9">
<p class="eyebrow">EINKAUFEN. GENIESSEN. ERLEBEN.</p>
<h1>{{ portal_city }} hat mehr zu bieten.</h1>
<p class="lead">Entdecken Sie lokale Geschäfte, Gastronomie, Dienstleistungen und Veranstaltungen direkt vor Ihrer Haustür.</p>
<form class="search-box d-flex gap-2" method="get" action="{{ path('company_index') }}" role="search">
<label class="visually-hidden" for="portal-search">Unternehmen suchen</label>
<input id="portal-search" class="form-control border-0" type="search" name="q" maxlength="100" placeholder="z. B. Schuhe, Café, Friseur">
<button class="btn btn-primary" type="submit">Suchen</button>
</form>
{% if categories is not empty %}<p class="small mt-3">Beliebt: {% for row in categories|slice(0, 4) %}<a class="ms-2 text-reset" href="{{ path('company_index', {kategorie: row.category.slug}) }}">{{ row.category.name }}</a>{% if not loop.last %} ·{% endif %}{% endfor %}</p>{% endif %}
</div>
<div class="col-lg-3">
<div class="hero-aside">
<strong>Lokal.<br>Lebendig.<br>Zusammen.</strong>
<p class="mt-3 mb-0">Das Beste liegt oft ganz nah.</p>
</div>
</div>
</div>
</div>
</section>
<section class="section" id="entdecken">
<div class="container">
<div class="section-heading">
<h2>Was möchten Sie entdecken?</h2>
<span class="text-secondary">Vielfalt direkt vor der Haustür</span>
</div>
{% if categories is empty %}<p class="text-secondary">Kategorien werden in Kürze ergänzt.</p>{% else %}<div class="row g-3">{% for row in categories %}<div class="col-6 col-md-4 col-lg-2">
{% include 'frontend/category/_card.html.twig' with {category: row.category, count: row.companyCount} %}
</div>{% endfor %}</div>{% endif %}
</div>
</section>
<section class="section bg-light" id="angebote"><div class="container"><div class="section-heading"><h2>Angebote &amp; Aktionen</h2><a href="{{ path('offer_index') }}">Alle Angebote</a></div>
{% if featured_offers is empty %}<p role="status">Aktuell sind keine Angebote verfügbar.</p>{% else %}<div class="row g-4">{% for offer in featured_offers %}<div class="col-md-4">{% include 'frontend/offer/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}
</div></section>
<section class="section bg-light" id="aktuelles"><div class="container"><div class="section-heading"><h2>Neuigkeiten von hier.</h2><a href="{{ path('news_index') }}">Alle Neuigkeiten</a></div>{% if featured_news is empty %}<p>Aktuell sind keine Neuigkeiten verfügbar.</p>{% else %}<div class="row g-4">{% for article in featured_news %}<div class="col-md-6 col-lg-4">{% include 'frontend/news/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
<section class="section" id="veranstaltungen"><div class="container"><div class="section-heading"><h2>Gemeinsam etwas erleben.</h2><a href="{{ path('event_index') }}">Alle Veranstaltungen</a></div>{% if upcoming_events is empty %}<p>Aktuell sind keine Veranstaltungen verfügbar.</p>{% else %}<div class="row g-4">{% for occurrence in upcoming_events %}<div class="col-md-6 col-lg-4">{% include 'frontend/event/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
<section class="section bg-light" id="unternehmen">
<div class="container">
<div class="section-heading">
<h2>Unternehmen entdecken</h2>
<span class="text-secondary">Menschen und Ideen von hier</span>
</div>
{% if featured_companies is empty %}<p class="text-secondary">Es sind noch keine Unternehmen eingetragen.</p>{% else %}<div class="row g-4">{% for company in featured_companies %}<div class="col-sm-6 col-lg-4">{% include 'frontend/company/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}
<p class="mt-4 mb-0"><a class="btn btn-outline-primary" href="{{ path('company_index') }}">Alle Unternehmen <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a></p>
</div>
</section>
<section class="section gift-section" id="gutschein">
<div class="container">
<div class="row align-items-center gy-4">
<div class="col-md-8">
<p class="eyebrow">FREUDE SCHENKEN. REGIONAL DENKEN.</p>
<h2>Der Haselünner Gutschein</h2>
<p class="lead">Eine Idee, viele Möglichkeiten: regional schenken und lokale Unternehmen unterstützen.</p>
<p>{{ voucher_acceptance_count }} teilnehmende Akzeptanzstellen.</p><a class="btn btn-primary" href="{{ path('voucher_index') }}">Gutschein entdecken</a>
</div>
<div class="col-md-4 gift-icon">
<i class="fa-solid fa-gift" aria-hidden="true">
</i>
</div>
</div>
</div>
</section>
<section class="section" id="jobs"><div class="container"><div class="section-heading"><h2>Ihre Zukunft liegt vor Ort.</h2><a href="{{ path('job_index') }}">Alle Jobs</a></div>{% if featured_jobs is empty %}<p>Aktuell sind keine offenen Stellen verfügbar.</p>{% else %}<div class="row g-4">{% for job in featured_jobs %}<div class="col-md-6 col-lg-4">{% include 'frontend/job/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}</div></section>
<section class="section pt-0" id="mitglied">
<div class="container">
<div class="join-box">
<div class="row align-items-center gy-4">
<div class="col-lg-8">
<p class="small">WERBEKREIS {{ portal_city|upper }}</p>
<h2>Gemeinsam ist hier mehr möglich.</h2>
<p class="mb-0">Stärken Sie mit uns den Standort {{ portal_city }}. Werden Sie Teil eines Netzwerks, das vor Ort etwas bewegt.</p>
</div>
<div class="col-lg-4 text-lg-end">
<a class="btn btn-light" href="mailto:{{ portal_contact_email }}">Mitglied werden <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true">
</i>
</a>
</div>
</div>
</div>
</div>
</section>
{% endblock %}
