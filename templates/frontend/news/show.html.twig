{% extends 'base.html.twig' %}
{% block title %}{{ article.title }} | {{ portal_name }}{% endblock %}
{% block meta_description %}{{ article.teaser ?: article.title }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('news_show', {slug: article.slug}) }}">{% endblock %}
{% block meta %}<meta property="og:title" content="{{ article.title }}"><meta property="og:description" content="{{ article.teaser ?: article.title }}"><meta property="og:type" content="article"><meta property="og:url" content="{{ url('news_show', {slug: article.slug}) }}">{% if article.imagePath %}<meta property="og:image" content="{{ url('news_image', {slug: article.slug, fileName: article.imagePath}) }}"><meta property="og:image:alt" content="{{ article.imageAltText ?: article.title }}">{% endif %}<script type="application/ld+json">{{ structured_data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>{% endblock %}
{% block body %}<article class="news-detail"><header class="directory-hero"><div class="container"><nav aria-label="Brotkrumen"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_home') }}">Startseite</a></li><li class="breadcrumb-item"><a href="{{ path('news_index') }}">Aktuelles</a></li><li class="breadcrumb-item active" aria-current="page">{{ article.title }}</li></ol></nav>{% include 'frontend/news/_categories.html.twig' %}<h1>{{ article.title }}</h1>{% include 'frontend/news/_meta.html.twig' %}<p class="lead">{{ article.teaser }}</p>{% if article.authorName %}<p>Von {{ article.authorName }}</p>{% endif %}</div></header>
<div class="section"><div class="container"><div class="news-content">{% if article.imagePath %}<img class="news-detail-image mb-4" src="{{ path('news_image', {slug: article.slug, fileName: article.imagePath}) }}" alt="{{ article.imageAltText ?: article.title }}">{% endif %}<div class="news-article-content">{{ article.content|nl2br }}</div>{% if article.externalUrl %}<p class="mt-4"><a href="{{ article.externalUrl }}" target="_blank" rel="noopener noreferrer">Weitere Informationen (öffnet in neuem Tab)</a></p>{% endif %}<p class="mt-4"><a href="{{ path('news_index') }}">Alle Neuigkeiten</a></p></div></div></div></article>{% endblock %}
