{% extends 'base.html.twig' %}
{% block title %}Aktuelles aus {{ portal_city }} | {{ portal_name }}{% endblock %}
{% block meta_description %}Neuigkeiten vom Werbekreis, den Unternehmen und dem Stadtleben in {{ portal_city }}.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('news_index') }}">{% if parameters is not empty or page > 1 %}<meta name="robots" content="noindex,follow">{% endif %}{% endblock %}
{% block body %}<header class="directory-hero"><div class="container"><h1>Aktuelles aus {{ portal_city }}</h1><p class="lead">Neuigkeiten und Geschichten von hier.</p>{% if company %}<p>Aktuelles von {{ company.name }}</p>{% endif %}
<form method="get" class="row g-3">{% if company %}<input type="hidden" name="unternehmen" value="{{ company.slug }}">{% endif %}<div class="col-md-9"><label for="news-category" class="form-label">Kategorie</label><select class="form-select" id="news-category" name="kategorie"><option value="">Alle Kategorien</option>{% for item in categories %}<option value="{{ item.slug }}"{{ category and category.id == item.id ? ' selected' }}>{{ item.name }}</option>{% endfor %}</select></div><div class="col-md-3 align-self-end"><button class="btn btn-primary w-100" type="submit">Filtern</button></div></form></div></header>
<section class="section"><div class="container"><h2 class="h4">{{ total }} {{ total == 1 ? 'Beitrag' : 'Beiträge' }}</h2>{% if articles is empty %}<p role="status">Aktuell sind keine Neuigkeiten für diese Auswahl verfügbar.</p>{% else %}<div class="row g-4">{% for article in articles %}<div class="col-md-6 col-lg-4">{% include 'frontend/news/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}{% include 'partials/_pagination.html.twig' with {route: 'news_index'} %}</div></section>{% endblock %}
