{% extends 'base.html.twig' %}
{% block body_class %}public-frontend{% endblock %}
{% block title %}Kontakt | {{ portal_name }}{% endblock %}
{% block meta_description %}Kontakt zum Werbekreis Haselünne e.V.: Anschrift, Telefon und E-Mail für Ihre Fragen und Anliegen.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('contact') }}">{% endblock %}
{% block body %}
<header class="directory-hero"><div class="container">
{% include 'partials/_breadcrumb.html.twig' with {items: [{label: 'Kontakt'}]} only %}
<h1>Kontakt</h1>
</div></header>
<section class="section"><div class="container"><div class="row g-4">
<div class="col-lg-6"><h2>Kontaktinformationen</h2>
{% include 'frontend/page/_address.html.twig' with {show_person: true} %}
{% include 'frontend/page/_contact_links.html.twig' %}
</div>
<div class="col-lg-6"><div class="page-cta"><h2>Sprechen Sie uns an</h2>
<p>Sie haben Fragen zum Werbekreis, möchten Mitglied werden oder eine Aktion mit uns besprechen? Sprechen Sie uns gerne an.</p>
<div class="d-flex flex-wrap gap-3"><a class="btn btn-primary" href="mailto:{{ portal_contact_email }}">E-Mail schreiben</a><a class="btn btn-outline-primary" href="tel:{{ portal_contact_phone|replace({' ': ''}) }}">Anrufen</a></div>
</div></div></div></div></section>
{% endblock %}
