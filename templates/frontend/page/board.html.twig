{% extends 'base.html.twig' %}
{% block body_class %}public-frontend{% endblock %}
{% block title %}Vorstand | {{ portal_name }}{% endblock %}
{% block meta_description %}Lernen Sie die Mitglieder und Funktionen des Vorstands des Werbekreises Haselünne kennen.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('board') }}">{% endblock %}
{% block body %}
<header class="directory-hero"><div class="container">
{% include 'partials/_breadcrumb.html.twig' with {items: [{label: 'Werbekreis', url: path('about')}, {label: 'Vorstand'}]} only %}
<h1>Unser Vorstand</h1>
<p class="lead">Der Werbekreis lebt vom ehrenamtlichen Engagement seiner Mitglieder.</p>
</div></header>
<section class="section"><div class="container"><div class="row g-4">
{% for person in [
    {name: portal_contact_name, role: '1. Vorsitzender'},
    {name: 'Norbert Schnakenberg', role: '2. Vorsitzender'},
    {name: 'Daniel Pesch', role: 'Schriftführer'},
    {name: 'Cornelia Sturm', role: 'Kassiererin'},
    {name: 'Christopher Jansen', role: 'Vorstand'},
    {name: 'Philipp Langen', role: 'Vorstand'},
    {name: 'Robert Münster', role: 'Vorstand'},
    {name: 'Ingo Hoffmeister', role: 'Vorstand'},
    {name: 'Tanja Kramer', role: 'Werbung'}
] %}
<div class="col-sm-6 col-lg-4"><div class="page-card"><h2>{{ person.name }}</h2><p>{{ person.role }}</p></div></div>
{% endfor %}
</div><p class="mt-4"><a href="{{ path('contact') }}">Kontakt zum Werbekreis</a></p></div></section>
{% endblock %}
