{% extends 'base.html.twig' %}
{% block title %}{{ job.title }} bei {{ job.company.name }} | Jobs in {{ portal_city }}{% endblock %}
{% block meta_description %}{{ job.shortDescription }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('job_show', {slug: job.slug}) }}">{% endblock %}
{% block meta %}
<meta property="og:title" content="{{ job.title }} bei {{ job.company.name }}"><meta property="og:description" content="{{ job.shortDescription }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ url('job_show', {slug: job.slug}) }}">
{% set image = job.company.coverImage ?: job.company.logoImage %}{% if image %}<meta property="og:image" content="{{ url('company_image', {slug: job.company.slug, fileName: image.fileName}) }}">{% endif %}
<script type="application/ld+json">{{ structured_data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
{% endblock %}
{% block body %}<article class="job-detail"><header class="directory-hero"><div class="container"><nav aria-label="Brotkrumen"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_home') }}">Startseite</a></li><li class="breadcrumb-item"><a href="{{ path('job_index') }}">Jobs</a></li><li class="breadcrumb-item active" aria-current="page">{{ job.title }}</li></ol></nav>{% include 'frontend/job/_employment.html.twig' %}<h1 class="mt-3">{{ job.title }}</h1>{% include 'frontend/job/_meta.html.twig' %}<p class="lead">{{ job.shortDescription }}</p></div></header>
<div class="section"><div class="container"><div class="row g-4"><div class="col-lg-8 job-content"><section><h2>Beschreibung</h2><div>{{ job.description|nl2br }}</div></section>{% if job.requirements %}<section class="mt-4"><h2>Anforderungen</h2><div>{{ job.requirements|nl2br }}</div></section>{% endif %}{% if job.benefits %}<section class="mt-4"><h2>Benefits</h2><div>{{ job.benefits|nl2br }}</div></section>{% endif %}
{% if job.salaryMin is not null or job.salaryMax is not null %}<section class="mt-4"><h2>Vergütung</h2>{% include 'frontend/job/_salary.html.twig' %}</section>{% endif %}{% if job.startsAt %}<p class="mt-4">Geplanter Arbeitsbeginn: {{ job.startsAt|date('d.m.Y', portal_timezone) }}</p>{% endif %}
{% if job.city or job.street or job.locationName or map_data.markers is not empty %}<section class="mt-4"><h2>Arbeitsort</h2><address>{% if job.locationName %}{{ job.locationName }}<br>{% endif %}{% if job.street %}{{ job.street }} {{ job.houseNumber }}<br>{% endif %}{{ job.postalCode }} {{ job.city }}</address>{% if map_data.markers is not empty %}{% include 'frontend/company/_map.html.twig' with {map_label: 'Karte des Arbeitsorts'} %}{% endif %}</section>{% endif %}<p class="mt-4"><a href="{{ path('company_show', {slug: job.company.slug}) }}">Mehr über {{ job.company.name }}</a></p></div><aside class="col-lg-4">{% include 'frontend/job/_application.html.twig' %}</aside></div><p class="mt-4"><a href="{{ path('job_index') }}">Alle Jobs</a></p></div></div></article>{% endblock %}
