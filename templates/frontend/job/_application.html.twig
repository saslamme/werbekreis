<section class="job-application" aria-labelledby="application-heading"><h2 id="application-heading">Bewerbung</h2>{% if job.applicationUrl %}<p><a class="btn btn-primary" href="{{ job.applicationUrl }}" target="_blank" rel="noopener noreferrer">Jetzt bewerben <span class="small">(externe Seite, neuer Tab)</span></a></p>{% endif %}{% if job.effectiveApplicationEmail %}<p><a class="btn btn-outline-primary" href="mailto:{{ job.effectiveApplicationEmail }}">Per E-Mail bewerben</a></p><p><a href="mailto:{{ job.effectiveApplicationEmail }}">{{ job.effectiveApplicationEmail }}</a></p>{% endif %}{% if job.contactName %}<p>Ansprechpartner: {{ job.contactName }}</p>{% endif %}{% if job.contactPhone %}<p>Telefon: <a href="tel:{{ job.contactPhone|replace({' ': '', '/': '', '(': '', ')': ''}) }}">{{ job.contactPhone }}</a></p>{% endif %}{% if job.referenceNumber %}<p>Referenznummer: {{ job.referenceNumber }}</p>{% endif %}{% if job.validThrough %}<p><strong>Bewerbung bis {{ job.validThrough|date('d.m.Y', portal_timezone) }}</strong></p>{% endif %}</section>
