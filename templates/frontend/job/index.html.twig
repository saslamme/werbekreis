{% extends 'base.html.twig' %}
{% block title %}Jobs in {{ portal_city }} | Stellenangebote beim {{ portal_name }}{% endblock %}
{% block meta_description %}Entdecken Sie aktuelle Stellenangebote der Unternehmen im Werbekreis {{ portal_city }} – von Ausbildung und Minijob bis Vollzeit.{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('job_index') }}">{% if parameters is not empty or page > 1 %}<meta name="robots" content="noindex,follow">{% endif %}{% endblock %}
{% block body %}
<header class="directory-hero"><div class="container"><h1>Jobs in {{ portal_city }}</h1><p class="lead">Arbeiten, wo wir zu Hause sind. Entdecken Sie offene Stellen von hier.</p>
<form method="get" class="row g-3" role="search"><div class="col-12"><label class="form-label" for="job-search">Suchbegriff</label><input type="search" id="job-search" name="q" value="{{ filters.q }}" class="form-control" maxlength="100" placeholder="Titel, Unternehmen oder Ort"></div>
<div class="col-md-4"><label class="form-label" for="job-employment">Beschäftigungsart</label><select id="job-employment" name="employmentType" class="form-select"><option value="">Alle Beschäftigungsarten</option>{% for type in employment_types %}<option value="{{ type.value }}"{{ filters.employmentType == type.value ? ' selected' }}>{{ type.label }}</option>{% endfor %}</select></div>
<div class="col-md-4"><label class="form-label" for="job-model">Arbeitsmodell</label><select id="job-model" name="workModel" class="form-select"><option value="">Alle Arbeitsmodelle</option>{% for model in work_models %}<option value="{{ model.value }}"{{ filters.workModel == model.value ? ' selected' }}>{{ model.label }}</option>{% endfor %}</select></div>
<div class="col-md-4"><label class="form-label" for="job-company">Unternehmen</label><select id="job-company" name="unternehmen" class="form-select"><option value="">Alle Unternehmen</option>{% for company in companies %}<option value="{{ company.slug }}"{{ filters.unternehmen == company.slug ? ' selected' }}>{{ company.name }}</option>{% endfor %}</select></div>
<div class="d-flex flex-wrap gap-3"><button class="btn btn-primary" type="submit">Stellen suchen</button><a class="btn btn-outline-primary" href="{{ path('job_index') }}">Filter zurücksetzen</a></div></form></div></header>
<section class="section"><div class="container"><h2 class="h4">{{ total }} {{ total == 1 ? 'Stellenangebot' : 'Stellenangebote' }}</h2>{% if jobs is empty %}<p role="status">Aktuell wurden keine passenden Stellenangebote gefunden.</p><a href="{{ path('job_index') }}">Filter zurücksetzen</a>{% else %}<div class="row g-4">{% for job in jobs %}<div class="col-md-6 col-lg-4">{% include 'frontend/job/_card.html.twig' %}</div>{% endfor %}</div>{% endif %}{% include 'partials/_pagination.html.twig' with {route: 'job_index'} %}</div></section>
{% endblock %}
