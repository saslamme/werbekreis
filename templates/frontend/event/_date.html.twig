<p class="event-time"><time datetime="{{ occurrence.startsAt|date('c', portal_timezone) }}">{{ occurrence.startsAt|date('d.m.Y', portal_timezone) }}{% if not event.allDay %}, {{ occurrence.startsAt|date('H:i', portal_timezone) }} Uhr{% endif %}</time> – <time datetime="{{ occurrence.endsAt|date('c', portal_timezone) }}">{{ occurrence.endsAt|date('d.m.Y', portal_timezone) }}{% if not event.allDay %}, {{ occurrence.endsAt|date('H:i', portal_timezone) }} Uhr{% endif %}</time>{% if event.allDay %} · Ganztägig{% endif %}</p>
