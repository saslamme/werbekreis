{% set calendar_parameters = parameters|filter((v, k) => k != 'zeitraum') %}
<nav class="section-heading" aria-label="Monatsnavigation"><a href="{{ path('event_calendar', calendar_parameters|merge({month: month|date_modify('-1 month')|date('Y-m', portal_timezone)})) }}">← Vorheriger Monat</a><h2>{{ month|date('m.Y', portal_timezone) }}</h2><a href="{{ path('event_calendar', calendar_parameters|merge({month: month|date_modify('+1 month')|date('Y-m', portal_timezone)})) }}">Nächster Monat →</a></nav>
<p class="text-secondary">Mehrtägige Veranstaltungen erscheinen an jedem betroffenen Tag. Vergangene aktive Termine sind hier ebenfalls sichtbar.</p>
<div class="event-calendar"><div class="calendar-weekdays" aria-hidden="true">{% for day in ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] %}<span>{{ day }}</span>{% endfor %}</div>
<div class="calendar-days">{% for day in days %}<section class="calendar-day{{ not day.inMonth ? ' outside-month' }}" data-date="{{ day.date|date('Y-m-d', portal_timezone) }}"><h3><time datetime="{{ day.date|date('Y-m-d', portal_timezone) }}">{{ day.date|date('d.m.', portal_timezone) }}</time></h3><ul class="list-unstyled">{% for occurrence in day.events %}<li><a href="{{ path('event_occurrence', {slug: occurrence.event.slug, id: occurrence.id}) }}">{{ occurrence.event.title }}</a>{% if occurrence.event.cancelled %}<span class="d-block">Abgesagt</span>{% endif %}{% if occurrence.event.allDay %}<span class="d-block">Ganztägig</span>{% endif %}</li>{% endfor %}</ul></section>{% endfor %}</div></div>
{% if occurrences is empty %}<p class="mt-3">Für diesen Monat sind keine Veranstaltungen eingetragen.</p>{% endif %}
