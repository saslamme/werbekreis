{% extends 'base.html.twig' %}
{% block title %}{{ event.title }} | Veranstaltungen in {{ portal_city }}{% endblock %}
{% block meta_description %}{{ event.shortDescription ?: event.title }}{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('event_occurrence', {slug: event.slug, id: occurrence.id}) }}">{% endblock %}
{% block meta %}<meta property="og:title" content="{{ event.title }}"><meta property="og:description" content="{{ event.shortDescription ?: event.title }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ url('event_occurrence', {slug: event.slug, id: occurrence.id}) }}">{% if event.imagePath %}<meta property="og:image" content="{{ url('event_image', {slug: event.slug, fileName: event.imagePath}) }}"><meta property="og:image:alt" content="{{ event.imageAlt ?: event.title }}">{% endif %}
<script type="application/ld+json">{{ structured_data|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>{% endblock %}
{% block body %}<article class="event-detail"><header class="directory-hero"><div class="container"><nav aria-label="Brotkrumen"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{ path('app_home') }}">Startseite</a></li><li class="breadcrumb-item"><a href="{{ path('event_index') }}">Veranstaltungen</a></li><li class="breadcrumb-item active" aria-current="page">{{ event.title }}</li></ol></nav><h1>{{ event.title }}</h1><p class="lead">{{ event.shortDescription }}</p><p>{% for category in event.publicCategories %}<a href="{{ path('event_index', {kategorie: category.slug}) }}">{{ category.name }}</a>{{ not loop.last ? ' · ' }}{% endfor %}</p>{% include 'frontend/event/_date.html.twig' %}<p class="fw-bold">{{ occurrence.statusAt(now) }}</p>{% if event.cancelled %}<div class="alert alert-warning">Diese Veranstaltung ist abgesagt. {{ event.cancellationNotice }}</div>{% endif %}</div></header>
<div class="section"><div class="container"><div class="row g-4"><div class="col-lg-8">
{% if event.imagePath %}<img class="offer-detail-image mb-4" src="{{ path('event_image', {slug: event.slug, fileName: event.imagePath}) }}" alt="{{ event.imageAlt ?: event.title }}">{% endif %}
<section class="company-section"><h2>Über die Veranstaltung</h2><div class="company-description">{{ event.description|nl2br }}</div></section>
{% if event.occurrences|length > 1 %}<section class="company-section"><h2>Weitere Termine der Serie</h2><ul>{% for item in event.occurrences %}<li><a href="{{ path('event_occurrence', {slug: event.slug, id: item.id}) }}">{{ item.startsAt|date('d.m.Y', portal_timezone) }}{% if not event.allDay %}, {{ item.startsAt|date('H:i', portal_timezone) }} Uhr{% endif %}</a></li>{% endfor %}</ul></section>{% endif %}
</div><aside class="col-lg-4"><section class="company-panel"><h2 class="h4">Wann?</h2>{% include 'frontend/event/_date.html.twig' %}</section>
<section class="company-panel"><h2 class="h4">Wo?</h2><p>{{ event.locationName }}</p><address>{{ event.street }} {{ event.houseNumber }}<br>{{ event.postalCode }} {{ event.city }}</address>{% if event.hasCoordinates %}{% include 'frontend/company/_map.html.twig' with {map_label: 'Karte des Veranstaltungsorts'} %}<a href="https://www.openstreetmap.org/directions?to={{ event.latitude }},{{ event.longitude }}" target="_blank" rel="noopener noreferrer">Route planen (öffnet in neuem Tab)</a>{% endif %}</section>
<section class="company-panel"><h2 class="h4">Veranstalter</h2><p>{{ event.organizerLabel }}</p>{% if event.company and event.company.active %}<p><a href="{{ path('company_show', {slug: event.company.slug}) }}">{{ event.company.name }}</a></p>{% endif %}{% if event.organizerEmail %}<p><a href="mailto:{{ event.organizerEmail }}">{{ event.organizerEmail }}</a></p>{% endif %}{% if event.organizerPhone %}<p>{{ event.organizerPhone }}</p>{% endif %}
{% for label, link in {'Website des Veranstalters': event.organizerWebsite, 'Weitere Informationen': event.externalUrl, 'Tickets beim externen Anbieter': event.ticketUrl} %}{% if link %}<p><a href="{{ link }}" target="_blank" rel="noopener noreferrer">{{ label }} (öffnet in neuem Tab)</a></p>{% endif %}{% endfor %}</section>
{% if event.freeAdmission or event.admissionText %}<section class="company-panel"><h2 class="h4">Eintritt</h2>{% if event.freeAdmission %}<p>Eintritt frei</p>{% endif %}<p>{{ event.admissionText }}</p></section>{% endif %}
</aside></div><p><a href="{{ path('event_index') }}">Alle Veranstaltungen</a></p></div></div></article>{% endblock %}
