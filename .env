APP_ENV=dev
APP_SECRET=
DATABASE_URL="mysql://app:password@127.0.0.1:3306/werbekreis?serverVersion=mariadb-10.11.0&charset=utf8mb4"

COMPANY_UPLOAD_DIR=%kernel.project_dir%/var/uploads/companies

# Search-only geocoding, no API key. Use an identifiable production User-Agent.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="Werbekreis/1.0 (https://github.com/saslamme/werbekreis)"
GEOCODING_TIMEOUT=3
GEOCODING_CACHE_TTL=86400
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
